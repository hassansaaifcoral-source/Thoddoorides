# Copy this file to ".env" and adjust for your environment.
# In production, NODE_ENV=production makes JWT_SECRET mandatory and
# enables secure cookies.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Security (REQUIRED in production) ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Force https-only cookies even in development if you terminate TLS upstream.
# COOKIE_SECURE=true
SESSION_HOURS=12

# --- First-run staff account (only used if no users exist yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=thoddoo123
ADMIN_NAME=Owner

# --- Business defaults (also editable later in the settings table) ---
DAILY_RATE_MVR=300
MVR_PER_USD=15.42
WHATSAPP_NUMBER=9607770000
PHONE_NUMBER=+9607770000
FLEET_SIZE=4

# --- Uploads ---
# UPLOAD_MAX_BYTES=8388608        # 8 MB
# DATA_DIR=/var/lib/thoddoo       # where the db + uploads live
